# Resource embedding helper for the official archive, whose referenced script
# was absent. Preserve resource names consumed by NanoGUI.
if(NOT DEFINED INPUT_FILES OR NOT DEFINED OUTPUT_C OR NOT DEFINED OUTPUT_H)
  message(FATAL_ERROR "INPUT_FILES, OUTPUT_C and OUTPUT_H are required")
endif()
string(REPLACE "," ";" resources "${INPUT_FILES}")
file(WRITE "${OUTPUT_H}" "#pragma once\n")
file(WRITE "${OUTPUT_C}" "#include \"nanogui_resources.h\"\n")
foreach(resource IN LISTS resources)
  get_filename_component(name "${resource}" NAME)
  string(TOLOWER "${name}" name)
  string(REGEX REPLACE "[^a-z0-9_]" "_" name "${name}")
  file(READ "${resource}" data HEX)
  string(LENGTH "${data}" length)
  math(EXPR size "${length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${data}")
  file(APPEND "${OUTPUT_H}" "extern const unsigned char ${name}[];\nextern const unsigned int ${name}_size;\n")
  file(APPEND "${OUTPUT_C}" "const unsigned char ${name}[] = {${bytes}0};\nconst unsigned int ${name}_size = ${size};\n")
endforeach()
